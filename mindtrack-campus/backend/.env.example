DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
ENVIRONMENT=development
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[SUPABASE_PUBLISHABLE_OR_ANON_KEY]
CORS_ORIGINS=http://localhost:5173

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER regenerate this once real journal data exists — existing entries become undecryptable.
JOURNAL_ENCRYPTION_KEY=[FERNET_KEY]
